# Service
RAG_SERVICE_NAME=CQUST RAG Service
RAG_ENV=local
RAG_HOST=0.0.0.0
RAG_PORT=8001
RAG_DATA_DIR=./data
RAG_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Auth: keep these values aligned with backend-go JWT_SECRET/JWT_ISSUER.
RAG_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
RAG_JWT_ISSUER=tap

# DashScope / Alibaba Cloud
DASHSCOPE_API_KEY=
DASHSCOPE_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
RAG_RERANK_MODEL=qwen3-vl-rerank
RAG_CHAT_MODEL=qwen-plus

# Retrieval defaults
RAG_DEFAULT_TOP_K=30
RAG_DEFAULT_RERANK_TOP_N=5
RAG_DEFAULT_SCORE_THRESHOLD=0.0
RAG_COVERAGE_THRESHOLD=0.4
RAG_MAX_UPLOAD_MB=50

# Web fallback
RAG_WEB_FALLBACK_ENABLED=true
RAG_WEB_MAX_RESULTS=5
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
